{
  "name": "lab-testing-ia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Laboratorio: full stack testing con IA sin inflar la suite",
  "scripts": {
    "start": "node src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=reports/vitest.json",
    "budget": "npm run test:report && node scripts/test-budget.mjs",
    "mutation": "stryker run",
    "solucion": "SOLUCION=1 vitest run",
    "solucion:budget": "SOLUCION=1 vitest run --reporter=json --outputFile=reports/vitest.json && node scripts/test-budget.mjs",
    "solucion:mutation": "SOLUCION=1 stryker run"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "supertest": "^7.1.4",
    "vitest": "^5.0.5"
  }
}
