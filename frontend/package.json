{
  "name": "biblioteca-uc-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend de la Biblioteca UC (Next.js + MSW). Proyecto de ejemplo de IIC3143.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:mock": "cross-env NEXT_PUBLIC_API_MOCKING=enabled next dev --port 3000",
    "build": "next build",
    "build:mock": "cross-env NEXT_PUBLIC_API_MOCKING=enabled next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "api:generate": "openapi-typescript ../specs/api/openapi.yaml --output src/shared/api/schema.d.ts",
    "api:check": "node scripts/api-check.mjs",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "cross-env TZ=UTC vitest run --project unit --coverage",
    "test:contract": "vitest run --project contract",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:smoke": "node scripts/run-e2e.mjs --smoke",
    "test:visual:docker": "node scripts/visual-docker.mjs",
    "test:mutation": "cross-env TZ=UTC stryker run",
    "test:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-playwright": "^2.12.1",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
